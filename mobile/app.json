{
  "expo": {
    "name": "VerveQ",
    "slug": "verveq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "verveq",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.verveq.app",
      "infoPlist": {}
    },
    "android": {
      "package": "com.verveq.app",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "verveq.com",
              "pathPrefix": "/arena/"
            },
            {
              "scheme": "https",
              "host": "verveq.com",
              "pathPrefix": "/duel/"
            },
            {
              "scheme": "https",
              "host": "verveq.com",
              "pathPrefix": "/s/d/"
            },
            {
              "scheme": "https",
              "host": "verveq.com",
              "pathPrefix": "/older"
            },
            {
              "scheme": "https",
              "host": "verveq.com",
              "pathPrefix": "/letters"
            },
            {
              "scheme": "https",
              "host": "verveq.com",
              "pathPrefix": "/whos-older"
            },
            {
              "scheme": "https",
              "host": "verveq.com",
              "pathPrefix": "/missing-letters"
            },
            {
              "scheme": "https",
              "host": "verveq.com",
              "pathPrefix": "/weekend/crew/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#121212",
    "owner": "strait-systems",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dd4d3f25-909e-45bc-8d11-166599c9947e"
      }
    }
  }
}
